#!/usr/bin/env bash
# morning — daily startup ritual for your AI-powered dev environment
# Usage: morning            (interactive Pi session with briefing)
#        morning -q         (quick: just checks, no Pi)
set -eo pipefail  # removed -u to avoid unbound variable issues

BOLD="\033[1m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
DIM="\033[2m"
RESET="\033[0m"

echo -e "${BOLD}🌅 Good morning.${RESET}"
echo ""

# ── 1. System updates ────────────────────────────────────────────────
echo -e "${DIM}Checking for updates...${RESET}"

# Homebrew
brew_outdated=$(brew outdated --quiet 2>/dev/null | wc -l | tr -d ' ') || brew_outdated=0
if [ "$brew_outdated" -gt 0 ] 2>/dev/null; then
  echo -e "  🍺 ${YELLOW}${brew_outdated} brew updates${RESET} (brew upgrade)"
fi

# mise
mise_outdated=$(mise outdated 2>/dev/null | wc -l | tr -d ' ') || mise_outdated=0
if [ "$mise_outdated" -gt 0 ] 2>/dev/null; then
  echo -e "  📦 ${YELLOW}mise: ${mise_outdated} tools behind${RESET} (mise upgrade)"
fi

# Pi version
pi_current=$(pi --version 2>/dev/null | head -1) || pi_current="unknown"
echo -e "  ${GREEN}✓${RESET} Pi ${pi_current}"

# ── 2. Chrome for MCP ─────────────────────────────────────────────────
if curl -s --max-time 2 http://localhost:9222/json/version >/dev/null 2>&1; then
  browser_name=$(curl -s http://localhost:9222/json/version 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin).get('Browser','running'))" 2>/dev/null || echo "running")
  echo -e "  ${GREEN}✓${RESET} Browser DevTools: ${browser_name:-running} on :9222"
elif [ -d "/Applications/Google Chrome.app" ]; then
  echo -e "  🟡 Starting Chrome..."
  open -a "Google Chrome" --args --remote-debugging-port=9222 2>/dev/null
  sleep 2
  if curl -s --max-time 2 http://localhost:9222/json/version >/dev/null 2>&1; then
    echo -e "  ${GREEN}✓${RESET} Chrome started"
  else
    echo -e "  ${YELLOW}⚠ Chrome launched but DevTools not ready yet${RESET}"
  fi
else
  echo -e "  ${YELLOW}⚠ No browser on :9222, Chrome not found${RESET}"
fi

# ── 3. Memory ─────────────────────────────────────────────────────────
if command -v agent-memory &>/dev/null; then
  mem_chunks=$(agent-memory status 2>/dev/null | grep "Chunks:" | cut -d: -f2 | tr -d ' ') || mem_chunks="?"
  echo -e "  ${GREEN}✓${RESET} Memory: ${mem_chunks} chunks"
fi

# ── 4. Yesterday recap ────────────────────────────────────────────────
echo ""
echo -e "${BOLD}📋 Recent Pi sessions:${RESET}"

find ~/.pi/agent/sessions -name "*.jsonl" -maxdepth 3 -mtime -3 2>/dev/null | \
  while read f; do
    dir=$(basename "$(dirname "$f")")
    proj=$(echo "$dir" | sed 's/^--Users-geek4good-Projects-//' | sed 's/--/\//g' | sed 's/-/ /g')
    msgs=$(wc -l < "$f" 2>/dev/null | tr -d ' ')
    date=$(basename "$f" | cut -d_ -f1 | cut -dT -f1)
    printf "  ${DIM}%-28s${RESET} %s  ${DIM}%4s msgs${RESET}\n" "$proj" "$date" "$msgs"
  done | sort -t'2' -k2 -r | head -8

echo ""

# ── 5. Launch Pi ─────────────────────────────────────────────────────
if [[ "${1:-}" == "-q" ]]; then
  echo -e "${DIM}Ready. Run 'morning' (without -q) to start Pi.${RESET}"
  exit 0
fi

echo -e "${BLUE}▶ Starting Pi...${RESET}"

# Use cd and then exec — but exec only works if we're in an interactive shell
# If this script was sourced, use 'pi' directly instead of exec
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  # Script was sourced — just run pi in foreground
  cd ~/Projects/dotfiles || cd ~
  pi --name "morning-$(date +%Y-%m-%d)"
else
  # Script was executed directly — replace shell with pi
  cd ~/Projects/dotfiles || cd ~
  exec pi --name "morning-$(date +%Y-%m-%d)"
fi
