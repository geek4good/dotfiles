#!/usr/bin/env bash
# zmx-pick — project-aware zmx session picker
#
# Session naming: <project>-<program>
#   e.g. www-pi   → cd ~/Projects/www, run pi
#        www-term → cd ~/Projects/www, default shell
#
# Options:
#   --name    Print the default session name and exit (no fzf, no attach)
#   --help    Show this help

set -euo pipefail

# ── helpers ────────────────────────────────────────────────────────────────────

_usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
    exit 0
}

_project_slug() {
    local root name
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -n "$root" ]]; then
        name=$(basename "$root")
    else
        name=$(basename "$PWD")
    fi
    echo "$name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/-\+/-/g' | sed 's/^-//;s/-$//'
}

# ── parse args ─────────────────────────────────────────────────────────────────

print_only=false
for arg in "$@"; do
    case "$arg" in
        --name) print_only=true ;;
        --help) _usage ;;
        *)      echo "unknown argument: $arg" >&2; exit 1 ;;
    esac
done

# ── main ───────────────────────────────────────────────────────────────────────

project=$(_project_slug)
sessions=$(zmx list --short 2>/dev/null || true)
default="${project}-term"

# --name: just print and exit
if $print_only; then
    echo "$default"
    exit 0
fi

# No sessions at all → create immediately (skip fzf)
if [[ -z "$sessions" ]]; then
    exec zmx attach "$default"
fi

# Sort: current project sessions first, then others
current=$(echo "$sessions" | grep "^${project}-" 2>/dev/null || true)
others=$(echo "$sessions" | grep -v "^${project}-" 2>/dev/null || true)
if [[ -n "$current" && -n "$others" ]]; then
    sorted="${current}"$'\n'"${others}"
elif [[ -n "$current" ]]; then
    sorted="${current}"
else
    sorted="${others}"
fi

# Prepend default suggestion (dedup)
list=$({ echo "$default"; echo "$sorted"; } | awk '!seen[$0]++')

# fzf picker
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

echo "$list" | fzf \
    --print-query \
    --height=80% \
    --reverse \
    --prompt="zmx> " \
    --header="Enter: attach or create · <project>-<program> · term=shell · Esc: cancel" \
    --preview='zmx history {} | tail -50' \
    --preview-window=right:60%:follow \
> "$tmp"

rc=$?
query=$(sed -n '1p' "$tmp")
selected=$(sed -n '2p' "$tmp")

session=""
if [[ $rc -eq 0 && -n "$selected" ]]; then
    session=$selected
elif [[ -n "$query" && $rc -ne 130 ]]; then
    session=$query
else
    exit 130
fi

# ── remote session (server.session) ──────────────────────────────────────────

if [[ "$session" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*\.[a-zA-Z0-9] ]]; then
    server="${session%%.*}"
    ssh_hosts=$(grep "^Host " ~/.ssh/config | sed 's/^Host //' | sed 's/ //g' | grep -v '\*')
    if echo "$ssh_hosts" | grep -qx "$server"; then
        printf '\033[2J\033[H'
        exec autossh -M 0 -q "$session"
    fi
fi

# ── existing session → attach directly ────────────────────────────────────────

if echo "$sessions" | grep -qx "$session" 2>/dev/null; then
    printf '\033[2J\033[H'
    exec zmx attach "$session"
fi

# ── new session: resolve project directory and program ────────────────────────

program="term"
project_dir=""
found=false

# Handle explicit path input (e.g. ~/Projects/www)
if [[ "$session" =~ ^[~/\.] ]]; then
    explicit_path=$(eval echo "$session")
    slug=$(basename "$explicit_path" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/-\+/-/g' | sed 's/^-//;s/-$//')
    session="${slug}-term"
    project_dir="$explicit_path"
    found=true
fi

# ── 1. Match current project prefix (most common case) ──────────────────────
# We know $project from git root / PWD, so use it to extract the program.

if ! $found && [[ "$session" == "${project}-"* ]]; then
    program="${session#"${project}-"}"
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -n "$root" ]]; then
        project_dir="$root"
    else
        project_dir="$PWD"
    fi
    found=true
fi

# ── 2. Longest-prefix matching in ~/Projects (cross-project) ────────────────

if ! $found; then
    IFS='-' read -ra parts <<< "$session"
    num_parts=${#parts[@]}

    # Try full name as project directory
    dir=$(find ~/Projects -maxdepth 2 -name "$session" -type d 2>/dev/null | head -1)
    if [[ -n "$dir" ]]; then
        project_dir="$dir"
        found=true
    fi

    # Try progressively shorter prefixes
    if ! $found && [[ $num_parts -ge 2 ]]; then
        for (( i=num_parts; i>=2; i-- )); do
            proj_candidate=$(IFS=-; echo "${parts[*]:0:$((i-1))}")
            prog_candidate=$(IFS=-; echo "${parts[*]:$((i-1))}")

            dir=$(find ~/Projects -maxdepth 2 -name "$proj_candidate" -type d 2>/dev/null | head -1)
            if [[ -n "$dir" ]]; then
                project_dir="$dir"
                program="$prog_candidate"
                found=true
                break
            fi
        done
    fi
fi

# ── fallback directory picker ─────────────────────────────────────────────────

if [[ -z "$project_dir" ]]; then
    dir_tmp=$(mktemp)
    find ~/Projects -maxdepth 2 -type d -name '.git' -exec dirname {} \; 2>/dev/null | sort | fzf \
        --print-query \
        --height=80% \
        --reverse \
        --prompt="dir> " \
        --header="Pick or type path for '$session' · e.g. myapp or org/repo · Esc: use \$PWD" \
    > "$dir_tmp"
    dir_rc=$?
    dir_query=$(sed -n '1p' "$dir_tmp")
    dir_selected=$(sed -n '2p' "$dir_tmp")
    rm -f "$dir_tmp"

    if [[ $dir_rc -ne 130 && -n "$dir_query" ]]; then
        if [[ "$dir_query" =~ ^[~/\.] ]]; then
            project_dir=$(eval echo "$dir_query")
        elif [[ -n "$dir_selected" ]]; then
            project_dir=$dir_selected
        else
            project_dir="$HOME/Projects/$dir_query"
        fi
        mkdir -p "$project_dir"
    fi
fi

if [[ -n "$project_dir" ]]; then
    cd "$project_dir"
fi

# ── create and attach ─────────────────────────────────────────────────────────

printf '\033[2J\033[H'
if [[ "$program" != "term" ]]; then
    exec zmx attach "$session" "$program"
else
    exec zmx attach "$session"
fi
