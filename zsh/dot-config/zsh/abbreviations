# zsh-abbr user abbreviations — ported from fish (config.fish) + former zsh aliases.
# Managed by zsh-abbr (ABBR_USER_PATHS in dot-zshrc); deployed by mise.
# Add new ones with: abbr "name=expansion"   (this file updates on next save)

abbr "view=nvim -R"
abbr "vimdiff=nvim -d"
abbr "ll=ls -lh"
abbr "la=ls -lhA"
abbr "bubo=brew update && brew outdated"
abbr "bubc=brew upgrade && brew cleanup"
abbr "bcubo=brew update && brew outdated --cask"
abbr "bcubc=brew upgrade --cask && brew cleanup"
abbr "bubu=brew update && brew outdated && brew update && brew outdated --cask && brew upgrade && brew cleanup && brew upgrade --cask && brew cleanup"
abbr "ml=mise latest"
abbr "momu=mise outdated && mise upgrade -y"
abbr "za=zmx attach"
abbr "dc=docker.lima compose"
abbr "dps=docker.lima ps"
abbr "dpsa=docker.lima ps -a"
abbr "di=docker.lima images"
abbr "drm=docker.lima rm"
abbr "drmi=docker.lima rmi"
abbr "dl=docker.lima logs"
abbr "dsh=docker.lima exec -it"
abbr "gs=git status"
abbr "gl=git log --oneline -20"
abbr "gla=git log --oneline --all -20"
abbr "gd=git diff"
abbr "gds=git diff --staged"
abbr "ga=git add"
abbr "gap=git add -p"
abbr "gc=git commit"
abbr "gca=git commit -a"
abbr "gcam=git commit -am"
abbr "gp=git push"
abbr "gpf=git push --force-with-lease"
abbr "gpoh=git push origin HEAD"
abbr "gu=git pull"
abbr "gr=git rebase"
abbr "gri=git rebase -i"
abbr "gb=git branch"
abbr "gco=git checkout"
abbr "gsw=git switch"
abbr "gt=git tag"
abbr "gf=git fetch"
abbr "grv=git remote -v"
abbr "gclean=git clean -fd"
abbr "zk=zmx kill"
abbr "zl=zmx list"
abbr "zr=zmx run"
abbr "auto=npx autoskills"
abbr "p=pi update --all && ~/.pi/agent/post-update.sh && pi"
abbr "pua=pi update --all && ~/.pi/agent/post-update.sh"

# ── adapted for zsh ──
abbr "cf=v ~/.config/zsh/.zshrc"
abbr "rf=exec zsh"
abbr "oc=ocx oc -p ws"
abbr "psql-icecast=ssh -t ubuntu@severance 'docker exec -it $(docker ps -q --filter \"name=severance-db\") psql -U postgres -d icecast_stats'"

# ── global (expand in any position) ──
abbr -g "dotf=~/Projects/dotfiles"
