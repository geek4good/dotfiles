# ── Environment ──────────────────────────────────────────────────────────────
export LC_ALL="en_GB.UTF-8"
export EDITOR=nvim
export LESS=-FRX
export HOMEBREW_NO_ENV_HINTS=1
umask 022

# Make zsh behave like bash when it comes to special characters
# (also gives alt+D `kill-word` fish's kill-bigword semantics)
autoload -U select-word-style
select-word-style bash

# ── PATH ─────────────────────────────────────────────────────────────────────
# Order mirrors the fish config (minus the shims entry — mise activate
# supersedes it). brew shellenv below prepends /opt/homebrew/bin, as in fish.
typeset -U path
export PNPM_HOME="$HOME/Library/pnpm"
path=(
  $HOME/Applications
  $HOME/.bun/bin
  $HOME/.local/bin
  $PNPM_HOME
  $HOME/govuk/govuk-docker/exe
  $path
)

# ── Homebrew ─────────────────────────────────────────────────────────────────
eval "$(/opt/homebrew/bin/brew shellenv)"

# ── fnox (secrets at shell init) ─────────────────────────────────────────────
if command -v fnox >/dev/null 2>&1; then
  eval "$(fnox activate zsh)"
fi

# ── mise ─────────────────────────────────────────────────────────────────────
# Explicit path: PATH-lookup activation is fragile (see commit 730dd33 — the
# fish incident). One mise binary everywhere: ~/.local/bin/mise.
eval "$(~/.local/bin/mise activate zsh)"

# ── Keybindings ──────────────────────────────────────────────────────────────
# Base keymap BEFORE plugins load: plugins (zsh-abbr especially) wrap the
# bindings that exist at their load time — a bindkey -e after them resets the
# keymap and wipes plugin bindings (that's how abbr's space-expansion broke).
bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^l' clear-screen
bindkey '\ed' kill-word                     # alt+D kill-bigword (word style above)
bindkey '\e[127;4u' backward-kill-word      # delete key (CSI-u)
bindkey '\e[108;6u' clear-screen            # ctrl+shift+L (CSI-u)
# cmd+k (\e[107;9u) → zmx session picker: deferred — spec §5, follow-up #2

# ── History ──────────────────────────────────────────────────────────────────
HISTSIZE=50000
HISTFILE=~/.local/share/zsh/.zsh_history
SAVEHIST=10000
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_save_no_dups

# ── Options ──────────────────────────────────────────────────────────────────
setopt auto_cd              # `dirname` cd's, like fish
setopt interactivecomments  # `#` comments work interactively, like fish

# ── zinit ────────────────────────────────────────────────────────────────────
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
  mkdir -p "$(dirname $ZINIT_HOME)"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "$ZINIT_HOME/zinit.zsh"

zinit as="command" lucid from="gh-r" for \
    id-as="usage" \
    atpull="%atclone" \
    jdx/usage

# zsh-abbr user abbreviations file — v6's DEFAULT path is exactly
# ~/.config/zsh/abbreviations, which is where mise deploys
# zsh/dot-config/zsh/abbreviations. (ABBR_USER_PATHS does not exist in v6.)

# Plugin load order matters:
#   1. zsh-completions adds fpath entries → compinit must run after it
#   2. compinit before fzf-tab (its requirement)
#   3. fzf-tab after zsh-autosuggestions (its requirement)
#   4. zsh-syntax-highlighting LAST — it wraps every widget present at load
zinit light zsh-users/zsh-completions
autoload -Uz compinit && compinit
zinit light zsh-users/zsh-autosuggestions
zinit light olets/zsh-abbr
zinit light Aloxaf/fzf-tab
zinit light zsh-users/zsh-syntax-highlighting

zinit snippet OMZP::command-not-found
zinit snippet OMZP::docker-compose
zinit snippet OMZP::fancy-ctrl-z
zinit snippet OMZP::git

zinit cdreplay -q

# ── Completion styling ───────────────────────────────────────────────────────
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'

# ── The one alias ────────────────────────────────────────────────────────────
# Abbreviations expand visibly (fish-style) but can't chain; the ls color
# modifier is transparent, so it stays an alias and applies to abbr expansions
# (ll → `ls -lh` → alias → `ls --color -lh`) at execution time.
alias ls='ls --color'

# ── Functions ────────────────────────────────────────────────────────────────
v() { nvim "${@:-.}"; }

docker_start() {
  limactl start docker
  export DOCKER_HOST=$(limactl list docker --format 'unix://{{.Dir}}/sock/docker.sock')
}

docker_stop() {
  limactl stop docker
}

# ── Shell integrations ───────────────────────────────────────────────────────
eval "$(fzf --zsh)"
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# ── Prompt ───────────────────────────────────────────────────────────────────
eval "$(starship init zsh)"

# Usage legend for the prompt above. If you change symbols in
# starship/dot-config/starship.toml, update this too.
prompt_hint() {
  cat <<'EOF'
prompt anatomy:  [session in] ~/dir on  branch [git-status] [exit] ❯

  ❯ cyan           last command succeeded
  ❯ bright-purple  last command failed
  [127]            exit code of last command (shown when non-zero)
  session          zmx session name (inside zmx sessions only)

git status symbols (starship defaults):
  !   modified      +   staged       ?   untracked    ✘   deleted
  »   renamed       $   stashed      ⇡   ahead        ⇣   behind
  ⇕   diverged      =   conflicted
EOF
}

# ── Terminal title (fish_title parity) ───────────────────────────────────────
autoload -Uz add-zsh-hook
_set_title() { print -Pn "\e]0;${ZMX_SESSION:-%~}\a" }
add-zsh-hook precmd _set_title
