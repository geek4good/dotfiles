Host *
  AddKeysToAgent yes
  UseKeychain yes
  Compression yes
  ForwardAgent no
  KeepAlive yes
  IdentityFile ~/.ssh/id_ed25519
  SendEnv LANG
  SetEnv LC_ALL=

Host silo
  HostName 100.82.129.33
  User ubuntu
  ForwardAgent yes

Host = silo.*
  HostName 100.82.129.33
  User ubuntu
  RemoteCommand zmx attach %k
  RequestTTY yes
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlMaster auto
  ControlPersist 10m

