Host *
  AddKeysToAgent yes
  UseKeychain yes
  Compression yes
  ForwardAgent no
  KeepAlive yes
  IdentityFile ~/.ssh/id_ed25519
  SendEnv LANG
  SetEnv LC_ALL=

Host silo
  User ubuntu
  ForwardAgent yes

Host = silo.*
  HostName silo
  User ubuntu
  RemoteCommand zmx attach %k
  RequestTTY yes
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlMaster auto
  ControlPersist 10m

Host severance
  User ubuntu
  ForwardAgent yes

Host = severance.*
  HostName severance
  User ubuntu
  RemoteCommand zmx attach %k
  RequestTTY yes
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlMaster auto
  ControlPersist 10m
