#!/usr/bin/env bash
set -euo pipefail

export DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"

# mise is the deployment engine — groups are declared in mise.toml.
if ! command -v mise &>/dev/null; then
    echo "mise is required but not installed." >&2
    echo "Install it first: https://mise.jdx.dev/installation.html" >&2
    exit 1
fi

cd "$DOTFILES_DIR"

# Snapshot the worktree so we can report exactly what this run changed.
# sync deliberately NEVER discards repo state: edits that landed in the repo
# through symlinks (or new files ingested below) are surfaced in a report for
# review, not wiped.
BEFORE=$(mktemp)
AFTER=$(mktemp)
trap 'rm -f "$BEFORE" "$AFTER"' EXIT
git status --porcelain=v1 2>/dev/null | sort > "$BEFORE" || true

# Ingest any skills installed via `npx skills ...` into the repo before deploying
"$DOTFILES_DIR/bin/dot-local/bin/dotfiles-sync-skills"

# Deploy all dotfile groups. The post-dotfiles hook (mise.toml) re-applies
# Pi local customizations afterwards, as the stow-era script did.
mise dot apply

# ---- Drift report --------------------------------------------------------
# Anything that changed in the worktree during this run and was not already
# dirty before it. Kept in the worktree for you to review.
git status --porcelain=v1 2>/dev/null | sort > "$AFTER" || true
NEW_CHANGES=$(comm -13 "$BEFORE" "$AFTER" || true)

if [ -n "$NEW_CHANGES" ]; then
    ADOPTED=$(printf '%s\n' "$NEW_CHANGES" | grep -E '^[ MARC][MD]' || true)
    UNTRACKED=$(printf '%s\n' "$NEW_CHANGES" | grep '^??' || true)

    if [ -n "$ADOPTED" ]; then
        echo ""
        echo "⚠⚠ Edits landed in the repo through symlinks (kept, NOT discarded):"
        printf '%s\n' "$ADOPTED" | sed 's/^/    /'
        echo ""
        echo "    review:   git diff"
        echo "    keep:     git add -A && git commit"
        echo "    discard:  git checkout -- <file>"
        echo ""
    fi
    if [ -n "$UNTRACKED" ]; then
        echo "New files this run (ingested skills, etc.):"
        printf '%s\n' "$UNTRACKED" | sed 's/^/    /'
        echo ""
    fi
fi

echo "Done!"
