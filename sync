#!/usr/bin/env bash
set -euo pipefail

export DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"

# Install stow if needed
if ! command -v stow &>/dev/null; then
    echo "Installing stow..."
    brew install stow
fi

# Ingest any skills installed via `npx skills ...` into the repo before stowing
"$DOTFILES_DIR/bin/dot-local/bin/dotfiles-sync-skills"

# If packages specified, use those; otherwise stow all
if [ $# -gt 0 ]; then
    packages=("$@")
else
    packages=()
    for dir in "$DOTFILES_DIR"/*/; do
        packages+=("$(basename "$dir")")
    done
fi

cd "$DOTFILES_DIR"

# Remove gitignored paths that conflict with stow
_plugins_link="$HOME/.config/tmux/plugins"
_plugins_target="$DOTFILES_DIR/tmux/dot-config/tmux/plugins"
if [[ -L "$_plugins_link" || -d "$_plugins_link" ]]; then
    rm -rf "$_plugins_link"
fi

for pkg in "${packages[@]}"; do
    if [ ! -d "$pkg" ]; then
        echo "Package '$pkg' not found, skipping."
        continue
    fi

    echo "Stowing $pkg..."
    stow --dotfiles --no-folding --adopt --restow -t ~ "$pkg"
done

# Restore repo versions in case --adopt pulled in different files
git -C "$DOTFILES_DIR" checkout -- .

# Restore gitignored symlinks that were removed for stow
if [[ -d "$_plugins_target" && ! -e "$_plugins_link" ]]; then
    ln -s "$_plugins_target" "$_plugins_link"
    echo "Restored $_plugins_link"
fi

# Re-apply Pi theme overrides if patch exists
if [ -f "$HOME/.pi/agent/post-update.sh" ]; then
    "$HOME/.pi/agent/post-update.sh"
fi

echo "Done!"
