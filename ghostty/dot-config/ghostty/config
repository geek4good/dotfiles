# Font
font-size = 16

# no-clown-fiesta color scheme (ported from iTerm2)
background = #151515
foreground = #e1e1e1
cursor-color = #e1e1e1
cursor-text = #3b4252
selection-background = #4c566a
selection-foreground = #d8dee9

# Normal colors
palette = 0=#202020
palette = 1=#ac4142
palette = 2=#88afa2
palette = 3=#f4bf75
palette = 4=#73c0ff
palette = 5=#aa759f
palette = 6=#5f9ea0
palette = 7=#d0d0d0

# Bright colors
palette = 8=#555555
palette = 9=#cd5c5c
palette = 10=#90a959
palette = 11=#ffdeac
palette = 12=#a5d6ff
palette = 13=#cf76bd
palette = 14=#75b5aa
palette = 15=#e1e1e1

# Window
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = tabs

# ─── Splits ──────────────────────────────────────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Split creation: cmd+d / cmd+shift+d only
# (ctrl+space>h/j/k/l/z disabled — conflicts with Herdr prefix bindings)
# keybind = ctrl+space>z=toggle_split_zoom

# ─── Split navigation (disabled — Herdr handles this) ────────────────────────
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+j=goto_split:down
# keybind = ctrl+k=goto_split:up
# keybind = ctrl+l=goto_split:right
keybind = ctrl+shift+l=text:\x0c
# Disabled — ctrl+alt+h/l now handled by Herdr for tab cycling
# keybind = ctrl+alt+h=previous_tab
# keybind = ctrl+alt+l=next_tab

# ─── Tabs ────────────────────────────────────────────────────────────────────
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=goto_tab:9

# ─── Pane zoom ───────────────────────────────────────────────────────────────
keybind = cmd+z=toggle_split_zoom

# ─── Shell ───────────────────────────────────────────────────────────────────
# alt+shift+backspace → fish backward-kill-bigword
keybind = alt+shift+backspace=text:\x1b[127;4u

# ─── zmx session picker ──────────────────────────────────────────────────────
keybind = cmd+k=text:\x1b[107;9u

# ─── Neovim ──────────────────────────────────────────────────────────────────
keybind = cmd+p=text::GoToFile\n
keybind = cmd+shift+p=text::GoToCommand\n
