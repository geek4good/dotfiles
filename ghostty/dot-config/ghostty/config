# Font
font-size = 16

# no-clown-fiesta color scheme (ported from iTerm2)
background = #151515
foreground = #e1e1e1
cursor-color = #e1e1e1
cursor-text = #3b4252
selection-background = #4c566a
selection-foreground = #d8dee9

# Normal colors
palette = 0=#202020
palette = 1=#ac4142
palette = 2=#88afa2
palette = 3=#f4bf75
palette = 4=#73c0ff
palette = 5=#aa759f
palette = 6=#5f9ea0
palette = 7=#d0d0d0

# Bright colors
palette = 8=#555555
palette = 9=#cd5c5c
palette = 10=#90a959
palette = 11=#ffdeac
palette = 12=#a5d6ff
palette = 13=#cf76bd
palette = 14=#75b5aa
palette = 15=#e1e1e1

# Window
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = tabs

# ─── Splits ──────────────────────────────────────────────────────────────────
# Defaults + ctrl+space prefix chords
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = ctrl+space>h=new_split:left
keybind = ctrl+space>j=new_split:down
keybind = ctrl+space>k=new_split:up
keybind = ctrl+space>l=new_split:right

# ─── Split navigation ────────────────────────────────────────────────────────
# performable: = only intercept if a Ghostty split exists in that direction.
# Otherwise the key falls through to Neovim (see keymaps.lua <C-h/j/k/l>),
# giving seamless pane/split navigation across Ghostty AND Nvim.
# Note: when both a Ghostty pane AND an Nvim split exist in the same direction,
# Ghostty (the terminal) takes priority and moves panes.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right
# ctrl+l is bound to goto_split:right, so ctrl+shift+l sends form feed (clear)
keybind = ctrl+shift+l=text:\x0c

# ─── Tabs ────────────────────────────────────────────────────────────────────
# Defaults + ctrl+space prefix chords + direct shortcuts
keybind = cmd+t=new_tab
keybind = ctrl+space>t=new_tab

keybind = cmd+w=close_surface

keybind = ctrl+tab=next_tab
keybind = ctrl+space>n=next_tab

keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+space>p=previous_tab

keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=goto_tab:9
keybind = ctrl+space>one=goto_tab:1
keybind = ctrl+space>two=goto_tab:2
keybind = ctrl+space>three=goto_tab:3
keybind = ctrl+space>four=goto_tab:4
keybind = ctrl+space>five=goto_tab:5
keybind = ctrl+space>six=goto_tab:6
keybind = ctrl+space>seven=goto_tab:7
keybind = ctrl+space>eight=goto_tab:8
keybind = ctrl+space>nine=goto_tab:9

# ─── Pane zoom ───────────────────────────────────────────────────────────────
keybind = cmd+z=toggle_split_zoom

# ─── Shell ───────────────────────────────────────────────────────────────────
# alt+shift+backspace → fish backward-kill-bigword
keybind = alt+shift+backspace=text:\x1b[127;4u

# ─── zmx session picker ──────────────────────────────────────────────────────
keybind = cmd+k=text:\x1b[107;9u

# ─── Neovim ──────────────────────────────────────────────────────────────────
keybind = cmd+p=text::GoToFile\n
keybind = cmd+shift+p=text::GoToCommand\n
