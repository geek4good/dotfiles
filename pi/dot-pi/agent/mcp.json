{
  "settings": {
    "toolPrefix": "mcp",
    "idleTimeout": 10
  },
  "mcpServers": {
    "lightpanda": {
      "command": "uc",
      "args": ["exec", "-T", "lightpanda", "lightpanda", "mcp"]
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": ["chrome-devtools-mcp@latest"]
    }
  }
}
